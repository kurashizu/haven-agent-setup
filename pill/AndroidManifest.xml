<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.local.agentpill" android:versionCode="4" android:versionName="2.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <queries><package android:name="sh.haven.app"/></queries>
  <application android:label="Agent Pill" android:allowBackup="false">
    <!-- DUMP: only shell (and system) may drive the overlay, ordinary apps cannot -->
